@echo off
REM SunEatsSoup SetupComplete script: run once at the end of install (runs as SYSTEM)
REM This script copies the custom wallpaper over the default wallpaper so first user sees it.

SET SRC="%WINDIR%\Web\Wallpaper\SunEatsSoup\backgroundDefault.jpg"
SET DST="%WINDIR%\Web\Wallpaper\Windows\img0.jpg"

IF EXIST %SRC% (
    COPY /Y %SRC% %DST%
)

EXIT /B 0
@echo off
REM SunEatsSoup SetupComplete script: run once at the end of install (runs as SYSTEM)
REM This script copies the custom wallpaper over the default wallpaper so first user sees it.

SET SRC="%WINDIR%\Web\Wallpaper\SunEatsSoup\backgroundDefault.jpg"
SET DST="%WINDIR%\Web\Wallpaper\Windows\img0.jpg"

IF EXIST %SRC% (
    COPY /Y %SRC% %DST%
)

EXIT /B 0
<!-- Save this as sun_smiling_wallpaper.svg. Convert to a 1920x1080 JPG/PNG (recommended names below) -->
<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="sunGrad" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#fff59d"/>
      <stop offset="1" stop-color="#ffb74d"/>
    </linearGradient>
    <filter id="soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6"/>
    </filter>
  </defs>

  <!-- sky -->
  <rect width="100%" height="100%" fill="#b3e5fc"/>

  <!-- smiling sun -->
  <g transform="translate(380,220)">
    <circle cx="200" cy="200" r="160" fill="url(#sunGrad)" stroke="#ff8f00" stroke-width="8" />
    <!-- rays -->
    <g stroke="#ff8f00" stroke-width="10" stroke-linecap="round">
      <line x1="200" y1="-30" x2="200" y2="-90"/>
      <line x1="200" y1="430" x2="200" y2="490"/>
      <line x1="-30" y1="200" x2="-90" y2="200"/>
      <line x1="430" y1="200" x2="490" y2="200"/>
      <line x1="80" y1="80" x2="30" y2="30"/>
      <line x1="320" y1="320" x2="370" y2="370"/>
      <line x1="80" y1="320" x2="30" y2="370"/>
      <line x1="320" y1="80" x2="370" y2="30"/>
    </g>

    <!-- face -->
    <circle cx="155" cy="170" r="12" fill="#5d4037"/>
    <circle cx="245" cy="170" r="12" fill="#5d4037"/>
    <path d="M140 230 Q200 270 260 230" stroke="#5d4037" stroke-width="10" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- playful caption -->
  <text x="980" y="980" font-family="Segoe UI, Arial" font-size="36" fill="#37474f" text-anchor="middle">Your PC is sunny and smiling ☀️</text>
</svg>
